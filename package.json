{
  "name": "logseq-plugin-deepl-translate",
  "version": "1.4.0",
  "description": "Translate block text using DeepL API.",
  "main": "index.html",
  "author": "Nillorian",
  "license": "MIT",
  "logseq": {
    "id": "logseq-plugin-deepl-translate",
    "title": "DeepL Translator",
    "icon": "logo.png"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/main.ts --bundle --platform=browser --outfile=dist/main.js --define:__DEV__=false",
    "dev": "rm -rf dist && esbuild src/main.ts --bundle --platform=browser --outfile=dist/main.js --define:__DEV__=true --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "semantic-release ."
  },
  "dependencies": {
    "@logseq/libs": "^0.2.9"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/commit-analyzer": "^10.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^8.0.0",
    "@semantic-release/release-notes-generator": "^10.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.27.1",
    "jsdom": "^29.0.2",
    "semantic-release": "^25.0.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
